{
  "name": "techsoul-audit-suite",
  "version": "1.0.0",
  "description": "TechSoul AI Website Audit Suite",
  "main": "main.js",
  "author": {
    "name": "TechSoul",
    "email": "mail@techsoul.in"
  },
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --x64",
    "build:mac": "electron-builder --mac",
    "build:docker-win": "docker run --rm -v \"${PWD}:/project\" -v \"${PWD}/../dist:/project/dist\" electronuserland/builder:wine sh -c \"npm install && npm run build:win\""
  },
  "build": {
    "appId": "in.techsoul.audit-suite",
    "productName": "TechSoul Audit Suite",
    "copyright": "© 2025 TechSoul. All Rights Reserved.",
    "directories": {
      "output": "../dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "splash.html",
      "assets/**/*",
      "backend-dist/**/*"
    ],
    "extraResources": [
      {
        "from": "backend-dist/",
        "to": "backend/",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowDirChange": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TechSoul Audit Suite",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns",
      "category": "public.app-category.business"
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "electron-log": "^5.1.1"
  }
}
